   1          #include <string.h>//包含memset()
   2          #include "cunchu.h"
   3          daan tmp;
   4          unchar getwei(unlong t);//计算结果位数
   5          
   6          
   7          daan yunsuan(cunchu t)//运算函数
   8          {
   9   1        memset(&tmp,0,sizeof(tmp));//运算前将全部元素设置为0，避免残留
  10   1        if(t.yunsuanfu==1)//加法运算
  11   1        {
  12   2          tmp.answer=t.a+t.b;//得出结果
  13   2          tmp.chang=getwei(tmp.answer);//计算结果位数
  14   2        }
  15   1        
  16   1        if(t.yunsuanfu==2)//减法运算
  17   1        {
  18   2          if(t.a<t.b)//结果为负数
  19   2          {
  20   3            tmp.answer=t.b-t.a;
  21   3            tmp.fu=1;
  22   3          }
  23   2          else
  24   2            tmp.answer=t.a-t.b;//结果为正数
  25   2          tmp.chang=getwei(tmp.answer);//计算结果位数
  26   2        }
  27   1        
  28   1        if(t.yunsuanfu==3)//乘法运算
  29   1        {
  30   2          tmp.answer=t.a*t.b;//得出结果
  31   2          tmp.chang=getwei(tmp.answer);//计算结果位数
  32   2        } 
  33   1      
  34   1        if(t.yunsuanfu==4)//除法运算
  35   1        {
  36   2          unlong an=(t.a*1000)/t.b;
  37   2          tmp.answer=(an+5)/10;//进行四舍五入，保留两位小数
  38   2          tmp.zheng=tmp.answer/100;//结果整数部分
  39   2          tmp.xiao=tmp.answer%100;//结果小数部分(2位小数)
  40   2          tmp.chang=getwei(tmp.zheng);
  41   2        }
  42   1        return tmp;
  43   1      }
  44          
  45          unchar getwei(unlong t)//计算结果位数
  46          {
  47   1        unchar i=0;
  48   1        if (t==0) return 1;//0视为1位数
  49   1        while(t>0)
  50   1        {
  51   2          i++;
  52   2          t/= 10;
  53   2        }
  54   1        return i;
