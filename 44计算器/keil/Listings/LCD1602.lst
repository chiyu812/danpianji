  18          void LCD_chushi()//LCD初始化
  19          {
  20   1        xiez(0x38);
  21   1        xiez(0x0C);
  22   1        xiez(0x06);
  23   1        xiez(0x01);
  24   1      }
  25          
  26          void shuzi(unchar hang,unchar lie,unlong shuzi,unchar changdu) //显示无符号数字
  27          {
  28   1        unchar i;
  29   1        guangbiao(hang,lie);
  30   1        for(i=0;i<changdu;i++)
  31   1        { 
  32   2          xies(shuzi/cifang(10,changdu-i-1)%10 +0x30);
